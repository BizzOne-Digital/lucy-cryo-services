# MongoDB Atlas connection string (include the database name)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lucy-cryo?retryWrites=true&w=majority

# Long random string used to sign admin session cookies (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Initial administrator. The first successful login creates the AdminUser record.
ADMIN_EMAIL=
# bcrypt hash of the admin password. Generate: npm run hash-password -- "YourStrongPassword"
# IMPORTANT: escape every $ as \$ in .env files. On Vercel paste the raw hash.
ADMIN_PASSWORD_HASH=

# Public site URL (used for sitemap, canonical and Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://www.lucycryoservices.org

# Email notifications (SMTP) – new bookings/enquiries are emailed here
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=
NOTIFY_EMAIL=you@yourdomain.com
